rules_version = '2';

/**
 * Mama Care — Firebase Storage rules.
 *
 * Two kinds of bytes are stored here, and they are separated by path rather than by
 * convention:
 *
 *   mamacare/documents/{uid}/…   personal health documents — scans, lab results,
 *                                prescriptions, birth records, child health cards
 *   mamacare/mothers/{uid}/…     anything else a mother uploads for herself
 *   mamacare/reports/{uid}/…     exports and generated summaries a person requested
 *   mamacare/profiles|facilities|education|branding|public/…
 *                                public imagery, used when Cloudinary is not
 *                                configured for a deployment
 *
 * The sensitive prefixes are readable only by their owner (and an administrator),
 * are capped in size, and reject anything that is not a document or image type the
 * app actually accepts. Public imagery is readable by anyone — it is shown on the
 * public site — but only staff may write it.
 *
 * Role lookups use `firestore.get`, so an administrator's access here follows the
 * same role as everywhere else in the platform.
 */

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function firestoreRole() {
      if (!signedIn()) {
        return 'GUEST';
      }
      if (request.auth.token.role != null) {
        return string(request.auth.token.role);
      }
      return exists(/databases/(default)/documents/users/$(uid()))
        ? string(firestore.get(/databases/(default)/documents/users/$(uid())).data.role)
        : 'GUEST';
    }

    function isAdmin() {
      return firestoreRole() == 'ADMIN';
    }

    function isStaff() {
      return firestoreRole() in ['ADMIN', 'FACILITY_ADMIN', 'PROVIDER'];
    }

    function accountInGoodStanding() {
      return signedIn()
        && exists(/databases/(default)/documents/users/$(uid()))
        && firestore.get(/databases/(default)/documents/users/$(uid())).data.status in ['ACTIVE', 'PENDING_APPROVAL'];
    }

    /** 15 MB — the same ceiling the uploader enforces in the browser. */
    function withinDocumentSize() {
      return request.resource.size < 15 * 1024 * 1024;
    }

    /** 10 MB for imagery. */
    function withinImageSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function documentType() {
      return request.resource.contentType.matches('application/pdf.*')
        || request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('text/plain.*');
    }

    function imageType() {
      return request.resource.contentType.matches('image/.*');
    }

    /* ── Personal health documents ────────────────────────────────────── */

    match /mamacare/documents/{userId}/{fileName} {
      // The owner, and an administrator who can see that a file exists and remove
      // it. Never a clinician: a provider who needs a scan asks for it in person.
      allow read: if isAdmin() || (signedIn() && userId == uid());

      allow write: if isAdmin()
        || (accountInGoodStanding() && userId == uid() && withinDocumentSize() && documentType());
    }

    match /mamacare/mothers/{userId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && userId == uid());
      allow write: if isAdmin()
        || (accountInGoodStanding() && userId == uid() && withinDocumentSize() && documentType());
    }

    match /mamacare/reports/{userId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && userId == uid());
      allow write: if isAdmin() || (accountInGoodStanding() && userId == uid() && withinDocumentSize());
    }

    /* ── Public imagery ───────────────────────────────────────────────── */

    // Profile pictures are shown in the public provider directory and on care-team
    // cards, so they are readable by anyone; only the owner may replace theirs.
    match /mamacare/profiles/{fileName} {
      allow read: if true;
      allow write: if accountInGoodStanding() && withinImageSize() && imageType();
    }

    // Facility and education imagery is written by staff and read by everybody.
    match /mamacare/facilities/{fileName} {
      allow read: if true;
      allow write: if accountInGoodStanding() && isAdmin() && withinImageSize() && imageType();
    }

    match /mamacare/education/{fileName} {
      allow read: if true;
      allow write: if accountInGoodStanding() && isStaff() && withinImageSize() && imageType();
    }

    match /mamacare/branding/{fileName} {
      allow read: if true;
      allow write: if accountInGoodStanding() && isAdmin() && withinImageSize() && imageType();
    }

    match /mamacare/public/{fileName} {
      allow read: if true;
      allow write: if accountInGoodStanding() && isStaff() && withinImageSize() && imageType();
    }

    /* Everything else — including any path outside the mamacare root — is closed.
     * A new folder is denied until somebody writes a rule for it and says who it is
     * for, which is the same default the Firestore rules use. */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
