# MAMA CARE — environment variable reference
#
# This file is documentation only. Copy the relevant variables into:
#   - dashboard/.env.local      (Next.js)
#   - your shell / CI           (flutter --dart-define=...)
#   - Supabase secrets          (Edge Functions)
#
# NEVER commit real values.

# ── Supabase ────────────────────────────────────────────────────────────
# Your project URL and anon (public) key from Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Same two values for the Flutter app, passed as --dart-define:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── SMS gateway (Supabase Edge Function secrets only — never in the app) ─
# Provider: "twilio" or "http" (generic HTTP endpoint)
SMS_PROVIDER=twilio
SMS_INTERNAL_TOKEN=a-long-random-secret-for-cron-calls

# Twilio (when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+260970000000

# Generic HTTP gateway (when SMS_PROVIDER=http)
HTTP_SMS_ENDPOINT=https://sms-gateway.example/api/send
HTTP_SMS_API_KEY=xxxxxxxx
