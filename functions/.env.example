# MAMA CARE — API service environment
#
# Copy to `.env` in this folder for local development. These values are SERVER-SIDE
# only: the Cloudinary API secret and the Admin SDK credential never reach the
# browser, and none of the file paths below should point at a file that is
# committed to the repository.
#
# The web app (see web/.env.example) holds only the public half: cloud name and the
# unsigned upload preset.

# ── Service ───────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
# Origins allowed to call this API with credentials. Comma separated. Leave empty to
# accept same-origin requests only (recommended behind a proxy that rewrites Origin).
ALLOWED_ORIGINS=http://localhost:5173

# ── Firebase Admin ────────────────────────────────────────────────────────
# Project that ID tokens belong to.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Preferred on Cloud Run / Firebase Functions: no file needed, the runtime supplies
# credentials. For a local run, point at a service-account file OUTSIDE the repo:
#   GOOGLE_APPLICATION_CREDENTIALS=/home/you/secrets/mamacare-admin.json
# Never paste the JSON into a chat, an issue, or this file.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Cloudinary (media storage + signed delivery) ──────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Must match VITE_CLOUDINARY_UPLOAD_PRESET in the web app.
CLOUDINARY_UPLOAD_PRESET=mamacare_unsigned
# All assets live under this root, then per-purpose subfolders:
#   mamacare/{public,profiles,reports,documents,facilities,education,branding}
CLOUDINARY_ROOT_FOLDER=mamacare
MAX_UPLOAD_BYTES=20971520

# ── First administrator ───────────────────────────────────────────────────
# Comma-separated, lower-case emails allowed to promote THEIR OWN account to ADMIN
# exactly once, through POST /admin/bootstrap. Empty means the route is disabled and
# the first administrator must be set from the Firebase console.
BOOTSTRAP_ADMIN_EMAILS=

# ── Scheduled queue jobs ───────────────────────────────────────────────────
# Shared secret for POST /jobs/*. An administrator's ID token also works, so this is
# only needed for a cron that has no user. Generate: openssl rand -hex 32
SCHEDULER_INTERNAL_TOKEN=

# ── SMS reminders (approved provider only) ─────────────────────────────────
# twilio | http | queue-only | none
# `queue-only` writes the request to Firestore for an external sender; `none`
# disables SMS entirely and the interface says so.
SMS_PROVIDER=none
SMS_FROM_NUMBER=
# Twilio
TWILIO_ACCOUNT_SID=
SMS_AUTH_TOKEN=
# Generic HTTP gateway
SMS_ENDPOINT_URL=
SMS_API_KEY=

# ── Public contact form forwarding (optional) ─────────────────────────────
# Without these the message is still stored in Firestore; the site then offers the
# visitor a mailto link instead of pretending an email was sent.
SUPPORT_INBOX_EMAIL=
SUPPORT_FROM_ADDRESS=no-reply@mamacare.health
EMAIL_RELAY_ENDPOINT=
EMAIL_RELAY_API_KEY=

# ── Limits ─────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_IP=120
RATE_LIMIT_CONTACT_PER_HOUR=5
