# MAMA CARE — frontend environment.
# Copy to `.env.local` (git-ignored) and fill in. EVERY value in this file is a
# public browser value: Vite inlines `VITE_*` into the bundle, so nothing secret may
# live here. Cloudinary's API secret, the Firebase service account and SMS provider
# keys belong in ../functions/.env — see ../functions/.env.example.

# ── Firebase web app (Cloud Console → Project settings → Your apps) ──────
# With all four identity-critical values present the app uses Cloud Firestore and
# Firebase Auth. Leave them empty to run the device (IndexedDB) provider.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Google Analytics / Measurement ID.
VITE_FIREBASE_MEASUREMENT_ID=

# ── Browser push (Cloud Console → Project settings → Cloud Messaging) ─────
# The "Web Push certificates" key. It is public by design: it only lets this origin
# subscribe a browser to your own project. Registration tokens are generated per
# device at runtime and are never stored in source control.
VITE_FIREBASE_VAPID_KEY=

# ── Data provider override ────────────────────────────────────────────────
# local | firebase. Unset = auto: firebase when the config above is complete,
# otherwise local. Set `firebase` deliberately to make a misconfigured install fail
# loudly instead of quietly writing to the device.
VITE_DATA_PROVIDER=

# ── Device (local) provider ───────────────────────────────────────────────
# Seeds a demonstration dataset of facilities, staff, mothers, visits, alerts,
# referrals and appointments into IndexedDB on first run. Real records written
# through the normal code path — never a hard-coded array. Set to false for a
# clean install.
VITE_LOCAL_DEMO_SEED=true
# Emails that may claim the first ADMIN account on a device-mode install from
# Settings. This mirrors MC_BOOTSTRAP_ADMIN_EMAILS on the API service, which is the
# authoritative list for a Firebase install. It is an evaluation convenience, not a
# production privilege path.
VITE_LOCAL_ADMIN_EMAILS=

# ── Cloudinary (media) ────────────────────────────────────────────────────
# Cloud name + an UNSIGNED upload preset for browser uploads into the
# mamacare/public|education|branding|facilities folders. Sensitive folders
# (reports, documents, mothers) are uploaded through the API service with a SIGNED
# request; the preset must therefore be limited to the unsigned folders.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Custom delivery origin if the cloud uses a private CDN or CNAME.
VITE_CLOUDINARY_SECURE_BASE=https://res.cloudinary.com

# ── API service ───────────────────────────────────────────────────────────
# Relative by default so the dev server proxy and hosting rewrites both work.
VITE_API_BASE_URL=/api

# ── Branding, contacts and public pages ───────────────────────────────────
VITE_APP_NAME=MAMA CARE
VITE_APP_ENV=development
VITE_FACILITY_REGION=Lusaka Province, Zambia
VITE_ORG_NAME=MAMA CARE
VITE_ORG_PHONE=
VITE_ORG_ADDRESS=
VITE_ORG_HOURS=
VITE_SUPPORT_EMAIL=support@mamacare.health
VITE_SUPPORT_PHONE=
VITE_PRIVACY_EMAIL=
# Emergency numbers shown on the public site. There is no single centralised
# ambulance number outside Lusaka — set these to your own dispatch.
VITE_EMERGENCY_AMBULANCE=991
VITE_EMERGENCY_EMERGENCY=999
VITE_EMERGENCY_FIRE=993
VITE_EMERGENCY_LUSAKA_AMBULANCE=0211 220180
VITE_EMERGENCY_FACILITY_LINE=
