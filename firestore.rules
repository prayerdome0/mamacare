rules_version = '2';

/**
 * Mama Care — Firestore security rules.
 *
 * These rules are the enforcement layer. The TypeScript policy module in
 * `web/src/services/policy/policy.ts` mirrors them so the device-only build behaves
 * identically, but only this file stands between a crafted request and somebody
 * else's pregnancy record. Every rule below has a counterpart there; if you change
 * one, change the other.
 *
 * Principles, in order of importance:
 *
 *  1. A mother owns her health data. She can always read and write it, and she can
 *     always delete it. Nothing else in this file overrides that.
 *  2. A clinician reaches a patient's records only through an active care link, and
 *     never through the journal, personal documents, notifications or devices.
 *  3. A supporter sees only the categories the mother switched on for them.
 *  4. Roles come from the custom claim when it exists and from the profile document
 *     otherwise, so a deployment works before claims are wired up — but nobody can
 *     promote themselves, because `role` is not writable by its owner.
 *  5. Public content (published articles, active facilities, announcements, the
 *     global settings document) is readable by anyone, because the public site must
 *     work for a woman who has not registered and may never register.
 *
 * Two document ids are deterministic on purpose, so a rule can answer "is this
 * clinician linked to this patient?" with a single `exists()` rather than a query it
 * cannot run:
 *
 *   care_links/{motherUserId}__{providerUserId}
 *   supporters/{motherUserId}__{supporterEmail}
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Identity helpers ─────────────────────────────────────────────── */

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function email() {
      return signedIn() && request.auth.token.email != null ? request.auth.token.email : '';
    }

    function userDoc(id) {
      return /databases/$(database)/documents/users/$(id);
    }

    function profileExists(id) {
      return exists(userDoc(id));
    }

    /** The role on the token if an administrator set the claim, else the profile. */
    function role() {
      if (!signedIn()) {
        return 'GUEST';
      }
      if (request.auth.token.role != null) {
        return string(request.auth.token.role);
      }
      return profileExists(uid()) ? string(get(userDoc(uid())).data.role) : 'GUEST';
    }

    function isAdmin() {
      return role() == 'ADMIN';
    }

    function isFacilityAdmin() {
      return role() == 'FACILITY_ADMIN';
    }

    function isProvider() {
      return role() == 'PROVIDER';
    }

    function isMother() {
      return role() == 'MOTHER';
    }

    function isSupporter() {
      return role() == 'SUPPORTER';
    }

    function isStaff() {
      return isAdmin() || isFacilityAdmin() || isProvider();
    }

    /** Suspended and closed accounts keep their records but cannot write. */
    function accountInGoodStanding() {
      return signedIn()
        && profileExists(uid())
        && get(userDoc(uid())).data.status in ['ACTIVE', 'PENDING_APPROVAL'];
    }

    function myFacilityId() {
      return signedIn() && profileExists(uid()) && get(userDoc(uid())).data.facilityId != null
        ? get(userDoc(uid())).data.facilityId
        : '';
    }

    /* ── Care-sharing helpers ─────────────────────────────────────────── */

    function careLinkDoc(motherId) {
      return /databases/$(database)/documents/care_links/$(motherId + '__' + uid());
    }

    /** True when the signed-in clinician has an ACTIVE link to this patient. */
    function linkedClinician(motherId) {
      return signedIn()
        && (isProvider() || isFacilityAdmin())
        && exists(careLinkDoc(motherId))
        && get(careLinkDoc(motherId)).data.status == 'active';
    }

    function supporterLinkDoc(motherId) {
      return /databases/$(database)/documents/supporters/$(motherId + '__' + email().lower());
    }

    /** True when this account is the mother's active supporter. */
    function linkedSupporter(motherId) {
      return signedIn()
        && email() != ''
        && exists(supporterLinkDoc(motherId))
        && get(supporterLinkDoc(motherId)).data.status == 'active';
    }

    /** The mother this supporter account helps, from their own profile. */
    function supportsUserId() {
      return signedIn() && profileExists(uid()) && get(userDoc(uid())).data.supportsUserId != null
        ? string(get(userDoc(uid())).data.supportsUserId)
        : '';
    }

    function isMyPatient(ownerId) {
      return signedIn() && supportsUserId() == ownerId && linkedSupporter(ownerId);
    }

    function unchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    /** The owner, an administrator, or a clinician with an active care link. */
    function ownerCanRead(ownerId) {
      return signedIn() && (ownerId == uid() || isAdmin() || linkedClinician(ownerId));
    }

    /** A supporter reading the baby record of the mother they help. */
    function supporterOf(ownerId) {
      return signedIn() && ownerId == supportsUserId() && linkedSupporter(ownerId);
    }

    /** Category switches the mother set for this supporter. */
    function supporterCanSeeAppointments(motherId) {
      return linkedSupporter(motherId) && get(supporterLinkDoc(motherId)).data.permissions.appointments == true;
    }

    function supporterCanSeeReminders(motherId) {
      return linkedSupporter(motherId) && get(supporterLinkDoc(motherId)).data.permissions.reminders == true;
    }

    /* ── Accounts ─────────────────────────────────────────────────────── */

    match /users/{userId} {
      // Your own account, an administrator, the clinician you linked, your
      // supporter, and a facility administrator who shares your facility.
      allow get: if isAdmin()
        || (signedIn() && userId == uid())
        || linkedClinician(userId)
        || isMyPatient(userId)
        || (isFacilityAdmin() && profileExists(userId) && get(userDoc(userId)).data.facilityId == myFacilityId())
        // A mother may see the supporter account she invited.
        || (isMother() && profileExists(userId)
              && get(userDoc(userId)).data.role == 'SUPPORTER'
              && get(userDoc(userId)).data.supportsUserId == uid());

      // Listing accounts is an administrative function; everybody else reads by id.
      allow list: if isAdmin() || isFacilityAdmin();

      // Self-service registration. Administrator and facility roles are granted by
      // an existing administrator, never chosen at sign-up.
      allow create: if signedIn()
        && userId == uid()
        && request.resource.data.uid == userId
        && request.resource.data.role in ['MOTHER', 'SUPPORTER', 'PROVIDER'];

      // Owners manage their own profile but cannot touch the fields that carry
      // privilege. Administrators manage everything; facility administrators manage
      // providers at their own facility.
      allow update: if isAdmin()
        || (signedIn() && accountInGoodStanding() && userId == uid()
              && unchanged('role')
              && unchanged('status')
              && unchanged('privilegeVersion')
              && unchanged('uid')
              && unchanged('createdAt')
              && unchanged('providerId')
              && unchanged('facilityId'))
        || (isFacilityAdmin() && resource.data.facilityId == myFacilityId() && resource.data.role == 'PROVIDER');

      // Deleting your own account is a right, not a favour.
      allow delete: if isAdmin() || (signedIn() && userId == uid());
    }

    /* ── Health records owned by one person ───────────────────────────── */

    // Pregnancy, babies, reminders, appointments, observations, immunizations.
    // A linked clinician may read and add to these; a supporter only what was shared.
    match /pregnancies/{recordId} {
      allow read: if isAdmin() || ownerCanRead(resource.data.userId);
      allow create: if isAdmin() || (accountInGoodStanding() && request.resource.data.userId == uid());
      allow update, delete: if isAdmin() || (accountInGoodStanding() && resource.data.userId == uid());
    }

    match /babies/{recordId} {
      allow read: if isAdmin() || ownerCanRead(resource.data.userId) || supporterOf(resource.data.userId);
      allow create: if isAdmin() || (accountInGoodStanding() && request.resource.data.userId == uid());
      allow update, delete: if isAdmin() || (accountInGoodStanding() && resource.data.userId == uid());
    }

    match /reminders/{recordId} {
      allow read: if isAdmin()
        || ownerCanRead(resource.data.userId)
        || (resource.data.userId == supportsUserId() && supporterCanSeeReminders(resource.data.userId));
      allow create: if isAdmin() || (accountInGoodStanding() && request.resource.data.userId == uid());
      allow update, delete: if isAdmin() || (accountInGoodStanding() && resource.data.userId == uid());
    }

    match /appointments/{recordId} {
      allow read: if isAdmin()
        || ownerCanRead(resource.data.userId)
        || (resource.data.userId == supportsUserId() && supporterCanSeeAppointments(resource.data.userId));
      allow create: if isAdmin()
        || (accountInGoodStanding() && request.resource.data.userId == uid())
        // A clinician may book for a linked patient.
        || (accountInGoodStanding() && linkedClinician(request.resource.data.userId));
      allow update: if isAdmin()
        || (accountInGoodStanding() && resource.data.userId == uid())
        || (accountInGoodStanding() && linkedClinician(resource.data.userId));
      allow delete: if isAdmin() || (accountInGoodStanding() && resource.data.userId == uid());
    }

    match /observations/{recordId} {
      allow read: if isAdmin() || ownerCanRead(resource.data.userId);
      allow create: if isAdmin()
        || (accountInGoodStanding() && request.resource.data.userId == uid())
        || (accountInGoodStanding() && linkedClinician(request.resource.data.userId));
      allow update: if isAdmin()
        || (accountInGoodStanding() && resource.data.userId == uid())
        || (accountInGoodStanding() && linkedClinician(resource.data.userId) && resource.data.recordedBy == 'provider');
      allow delete: if isAdmin() || (accountInGoodStanding() && resource.data.userId == uid());
    }

    match /immunizations/{recordId} {
      allow read: if isAdmin() || ownerCanRead(resource.data.userId) || supporterOf(resource.data.userId);
      allow create: if isAdmin() || (accountInGoodStanding() && request.resource.data.userId == uid());
      // Only the mother records that a dose was given — it is her child's card.
      allow update, delete: if isAdmin() || (accountInGoodStanding() && resource.data.userId == uid());
    }

    // The journal is private to the person who wrote it. No clinician, no supporter,
    // no facility administrator — only an administrator, and only where the law
    // requires it.
    match /journal/{recordId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow create: if accountInGoodStanding() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin() || (accountInGoodStanding() && resource.data.userId == uid());
    }

    // Personal health documents: scans, lab results, prescriptions, birth records.
    // Deliberately narrower than the rest — a clinician who needs a scan asks for it
    // in person rather than reading it from storage.
    match /documents/{recordId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow create: if accountInGoodStanding() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin() || (accountInGoodStanding() && resource.data.userId == uid());
    }

    match /notifications/{recordId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow list: if isAdmin() || (signedIn() && request.query.limit <= 200);
      // The system, an administrator broadcasting, or a clinician notifying a
      // linked patient.
      allow create: if isAdmin()
        || (accountInGoodStanding() && linkedClinician(request.resource.data.userId))
        || (accountInGoodStanding() && request.resource.data.userId == uid());
      // Read state only. A notification cannot be rewritten after delivery.
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == uid() && unchanged('title') && unchanged('body') && unchanged('kind') && unchanged('link'));
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
    }

    match /devices/{recordId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow create, update: if accountInGoodStanding() && request.resource.data.userId == uid();
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
    }

    /* ── Messaging ────────────────────────────────────────────────────── */

    match /messages/{messageId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.fromUserId == uid() || resource.data.toUserId == uid()));
      allow create: if accountInGoodStanding()
        && request.resource.data.fromUserId == uid()
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != uid();
      // Marking a message read is the only edit anybody may make.
      allow update: if signedIn()
        && (resource.data.fromUserId == uid() || resource.data.toUserId == uid())
        && unchanged('body')
        && unchanged('fromUserId')
        && unchanged('toUserId')
        && unchanged('threadId')
        && unchanged('createdAt');
      // Messages are never deleted: report one instead, and an administrator decides.
      allow delete: if false;
    }

    /* ── Care sharing ─────────────────────────────────────────────────── */

    match /care_links/{linkId} {
      allow read: if isAdmin()
        || isFacilityAdmin()
        || (signedIn() && (resource.data.motherUserId == uid() || resource.data.providerUserId == uid()));

      // A mother grants a link; a clinician may only open a request she accepts.
      allow create: if accountInGoodStanding()
        && (request.resource.data.motherUserId == uid() || request.resource.data.providerUserId == uid())
        && linkId == request.resource.data.motherUserId + '__' + request.resource.data.providerUserId;

      allow update: if isAdmin()
        // The mother controls status, including revoking at any time.
        || (accountInGoodStanding() && resource.data.motherUserId == uid())
        // A clinician may withdraw a request they made, and nothing more.
        || (accountInGoodStanding() && resource.data.providerUserId == uid()
              && request.resource.data.status == 'revoked'
              && unchanged('motherUserId')
              && unchanged('providerUserId'));

      allow delete: if isAdmin() || (accountInGoodStanding() && resource.data.motherUserId == uid());
    }

    match /supporters/{linkId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.motherUserId == uid()
              || resource.data.supporterUserId == uid()
              || resource.data.supporterEmail == email().lower()));

      allow create: if accountInGoodStanding()
        && request.resource.data.motherUserId == uid()
        && linkId == request.resource.data.motherUserId + '__' + request.resource.data.supporterEmail;

      // The mother sets and changes permissions; the supporter may only accept.
      allow update: if isAdmin()
        || (accountInGoodStanding() && resource.data.motherUserId == uid())
        || (accountInGoodStanding()
              && (resource.data.supporterUserId == uid() || resource.data.supporterEmail == email().lower())
              && unchanged('motherUserId')
              && unchanged('permissions')
              && unchanged('supporterName')
              && unchanged('relationship'));

      allow delete: if isAdmin() || (accountInGoodStanding() && resource.data.motherUserId == uid());
    }

    /* ── Public content ───────────────────────────────────────────────── */

    match /articles/{articleId} {
      // Published public articles are readable by anyone; published mother-facing
      // articles by any signed-in person; drafts and provider-only content by staff.
      allow read: if (resource.data.status == 'published' && resource.data.audience == 'public')
        || (signedIn() && resource.data.status == 'published' && resource.data.audience != 'provider')
        || isStaff();

      // Staff write education. Publishing is an administrator decision, so a
      // provider cannot flip `status` to published and cannot delete.
      allow create: if accountInGoodStanding() && isStaff() && request.resource.data.status != 'published';

      // Staff edit drafts. Anything already published is an administrator's to
      // change, so a live article cannot be rewritten without a second clinician.
      allow update: if isAdmin()
        || (accountInGoodStanding() && isStaff()
              && resource.data.status != 'published'
              && request.resource.data.status != 'published');

      allow delete: if isAdmin();
    }

    match /facilities/{facilityId} {
      allow read: if isAdmin() || isFacilityAdmin() || resource.data.active == true;
      allow create: if accountInGoodStanding() && (isAdmin() || isFacilityAdmin());
      allow update: if isAdmin()
        || (accountInGoodStanding() && isFacilityAdmin() && resource.data.id == myFacilityId());
      // Removing a facility breaks history on appointments already recorded there.
      allow delete: if isAdmin();
    }

    match /providers/{providerId} {
      // The directory is public for verified, listed clinicians. Everybody else sees
      // only their own record — and administrators see all of them.
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == uid())
        || (resource.data.status == 'approved' && resource.data.listedInDirectory == true);
      // The directory has to be listable by a visitor who has not registered, and
      // rules evaluate a list query as a whole rather than per document, so a crafted
      // query can read rows the UI filters out. Verified detail reads stay restricted
      // above; see README “Security” for the recommended hardening (move licence and
      // verification fields into an admin-only subcollection) before going live.
      allow list: if request.query.limit <= 500;

      allow create: if accountInGoodStanding()
        && (request.resource.data.userId == uid()
              || (isFacilityAdmin() && request.resource.data.facilityId == myFacilityId()));

      // Verification fields belong to an administrator; a clinician edits their own
      // profile but cannot verify themselves.
      allow update: if isAdmin()
        || (accountInGoodStanding() && isFacilityAdmin() && resource.data.facilityId == myFacilityId())
        || (accountInGoodStanding() && resource.data.userId == uid()
              && unchanged('status')
              && unchanged('verifiedBy')
              && unchanged('verifiedAt')
              && unchanged('rejectionReason')
              && unchanged('userId'));

      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin()
        || resource.data.audience == 'all'
        || (signedIn() && resource.data.audience == 'mothers' && (isMother() || isSupporter()))
        || (signedIn() && resource.data.audience in ['providers', 'facility'] && isStaff());
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingsId} {
      // The global document holds support contacts and emergency numbers the public
      // site needs before anybody signs in.
      allow read: if settingsId == 'global' || isAdmin();
      // First-run bootstrap is allowed so a new deployment is never locked out;
      // after that only an administrator changes system settings.
      allow create: if (!exists(/databases/$(database)/documents/settings/$(settingsId))
              && request.resource.data.providerApprovalsRequired == true)
        || (accountInGoodStanding() && isAdmin());
      allow update, delete: if isAdmin();
    }

    /* ── Reports, feedback and the audit trail ────────────────────────── */

    match /reports/{reportId} {
      allow read: if isAdmin()
        || isFacilityAdmin()
        || (signedIn() && resource.data.reporterId == uid());
      // Anyone signed in may report something wrong or unsafe.
      allow create: if accountInGoodStanding() && request.resource.data.reporterId == uid();
      allow update: if isAdmin() || isFacilityAdmin();
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin()
        || isFacilityAdmin()
        || (signedIn() && (resource.data.userId == uid() || resource.data.email == email()));
      // The public contact form accepts messages from people who are not signed in.
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000;
      allow update: if isAdmin() || isFacilityAdmin();
      allow delete: if isAdmin();
    }

    match /audit_logs/{entryId} {
      // Append-only. The app stamps the actor; nobody rewrites history, and only an
      // administrator reads it.
      allow read, list: if isAdmin();
      allow create: if signedIn() && request.resource.data.actorId == uid();
      allow update, delete: if false;
    }

    /* ── Device-only stores ───────────────────────────────────────────── */

    // These three exist for the offline IndexedDB build (queued writes, local blob
    // copies and interface metadata). They have no business in a shared database,
    // so they are closed here rather than left to a default rule.
    match /outbox/{document=**} {
      allow read, write: if false;
    }

    match /blobs/{document=**} {
      allow read, write: if false;
    }

    match /meta/{document=**} {
      allow read, write: if false;
    }

    /* Everything not matched above is denied. That is the point: a new collection
     * added to the data layer is closed by default until somebody writes a rule for
     * it and explains, in a comment, who it is for. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
