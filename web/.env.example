# ─────────────────────────────────────────────────────────────────────────────
# MAMA CARE — environment template
#
# Copy to `web/.env.local` (that exact path — Vite reads it from the web package)
# and change only what your deployment needs. Every variable is OPTIONAL: the
# project's own Firebase and Cloudinary settings are committed as defaults in
# `web/src/config/env.ts`, so a fresh clone runs without a single variable set.
#
# Nothing in this file is a secret in the cryptographic sense. The Firebase web
# config is public by design — access is enforced by `firestore.rules` and
# `storage.rules`, never by hiding a key. Do not put a service account, an Admin
# SDK key or a Cloudinary API secret here; there is no server in this build to
# hold one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data provider ───────────────────────────────────────────────────────────
# `firebase` (default when the config below is complete) or `local`, which keeps
# everything in this browser's IndexedDB. `local` is how the app runs offline, on a
# demo machine, or before you have a Firebase project.
# VITE_DATA_PROVIDER=firebase

# ── Firebase (public web config) ────────────────────────────────────────────
# Console → Project settings → Your apps → SDK setup and configuration.
# VITE_FIREBASE_API_KEY=AIzaSyCh2OcQ4AKL0ENZolDxNVCC6ecwXmzEPHg
# VITE_FIREBASE_AUTH_DOMAIN=mamacare-33821.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=mamacare-33821
# VITE_FIREBASE_STORAGE_BUCKET=mamacare-33821.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=387829914499
# VITE_FIREBASE_APP_ID=1:387829914499:web:81cc4725ebf4283d72f4b6
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Web push ────────────────────────────────────────────────────────────────
# Console → Cloud Messaging → Web Push certificates. Without it, in-app
# notifications still work; only background push is unavailable.
# VITE_FIREBASE_VAPID_KEY=BErAoXP_z4iLUWopUmh6_gLaKYeaf5Mgtw5G4SouZMFonGbsT4kjuMWMHECH9vbPTx55hFoAFuc-fgZAGiWwGyc

# ── Cloudinary (public imagery only) ────────────────────────────────────────
# Cloud name and an UNSIGNED upload preset. Used for education covers, facility
# photos, profile pictures and branding. Personal health documents never go here —
# they are routed to Firebase Storage under the owner's uid.
# VITE_CLOUDINARY_CLOUD_NAME=mk2tulbt
# VITE_CLOUDINARY_UPLOAD_PRESET=Mamcare
# VITE_CLOUDINARY_SECURE_BASE=https://res.cloudinary.com

# ── Identity and branding ───────────────────────────────────────────────────
# VITE_APP_NAME=Mama Care
# VITE_APP_TAGLINE=Every Mother. Every Journey.
# VITE_APP_VERSION=3.0.0
# VITE_APP_ENV=development
# VITE_PUBLIC_URL=https://mamacare.health
# VITE_ORG_NAME=Mama Care
# VITE_ORG_PHONE=
# VITE_ORG_ADDRESS=Lusaka, Zambia
# VITE_ORG_HOURS=Support: Monday–Friday, 08:00–17:00 (CAT)

# ── Support and privacy contacts ────────────────────────────────────────────
# Shown in the footer, on the contact page and in the admin settings screen.
# VITE_SUPPORT_EMAIL=support@mamacare.health
# VITE_SUPPORT_PHONE=
# VITE_PRIVACY_EMAIL=data-protection@mamacare.health

# ── Market defaults ─────────────────────────────────────────────────────────
# Zambia first; the country picker still offers every other market.
# VITE_DEFAULT_COUNTRY=ZM
# VITE_DEFAULT_CURRENCY=ZMW
# VITE_DEFAULT_DIAL_CODE=+260
# VITE_FACILITY_REGION=Lusaka Province, Zambia

# ── Emergency numbers ───────────────────────────────────────────────────────
# These override the built-in Zambian short codes on the emergency page, in the
# mother app and in the public footer. Administrators can also edit them from
# Admin → Settings, which takes precedence over these values.
# VITE_EMERGENCY_EMERGENCY=999
# VITE_EMERGENCY_POLICE=991
# VITE_EMERGENCY_FIRE=993
# VITE_EMERGENCY_AMBULANCE=991
# VITE_EMERGENCY_LUSAKA_AMBULANCE=0211 220180
# VITE_EMERGENCY_FACILITY_LINE=

# ── Operations ──────────────────────────────────────────────────────────────
# Comma-separated emails allowed to claim the first ADMIN account on a device-mode
# install. On a Firebase deployment, set the `role: ADMIN` custom claim instead —
# this list exists so a new deployment can never be locked out.
# VITE_BOOTSTRAP_ADMIN_EMAILS=

# Seed four demonstration accounts (mother, postnatal mother, provider, admin) on
# the first run of a device-mode install. Password: mamacare123
# VITE_LOCAL_DEMO_SEED=true
