rules_version = '2';

/**
 * MAMA CARE — Firestore security rules.
 *
 * These rules are the enforcement half of `web/src/services/policy/policy.ts`.
 * The client module decides what to render; this file decides what the database
 * will actually return or accept. They implement the same matrix on purpose, so
 * behaviour is identical whether a request comes from the browser, a stolen
 * browser, or a script using an ID token.
 *
 * Design notes
 * ────────────
 * • Roles come from custom claims (`role`, `facilityId`, `accountStatus`,
 *   `motherId`). Claims are only ever written by the API service with the Admin
 *   SDK, so a client cannot grant itself anything.
 * • Privileged writes (role changes, approvals, media deletion, SMS) are not
 *   available from the client at all — there is no rule that allows them; they go
 *   through the API service.
 * • Clinical rows are facility-scoped. A mother sees only rows whose `motherId`
 *   is her own record.
 * • `audit_logs` is append-only; `settings`/`alert_rules` are admin-managed.
 *
 * Deploy with: firebase deploy --only firestore
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── helpers ─────────────────────────────────────────────────────── */

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function claim(name) {
      return signedIn() && name in request.auth.token ? request.auth.token[name] : null;
    }

    function role() {
      return claim('role');
    }

    function facilityId() {
      return claim('facilityId');
    }

    function motherId() {
      return claim('motherId');
    }

    function isAdmin() {
      return role() == 'ADMIN';
    }

    function isSupervisor() {
      return role() == 'ADMIN' || role() == 'FACILITY_SUPERVISOR';
    }

    function isStaff() {
      return signedIn() && role() != 'MOTHER';
    }

    function isClinicalWriter() {
      return isAdmin() || isSupervisor() || role() == 'MIDWIFE' || role() == 'NURSE';
    }

    function isChw() {
      return role() == 'COMMUNITY_HEALTH_WORKER';
    }

    function isMother() {
      return role() == 'MOTHER';
    }

    /** Unapproved accounts may read their own profile and nothing clinical. */
    function pending() {
      return claim('accountStatus') == 'PENDING_APPROVAL';
    }

    function approved() {
      return signedIn() && !pending();
    }

    /** Any facility field on a document matching the caller's facility claim. */
    function sameFacility(data) {
      let fid = facilityId();
      return fid != null && (
        data.get(['facilityId']) == fid ||
        data.get(['registrationFacilityId']) == fid ||
        data.get(['careFacilityId']) == fid ||
        data.get(['originFacilityId']) == fid ||
        data.get(['receivingFacilityId']) == fid
      );
    }

    function facilityFieldEquals(data, field) {
      return facilityId() != null && data.get([field]) == facilityId();
    }

    function ownedByMother(data) {
      let mid = motherId();
      return mid != null && (data.get(['motherId']) == mid || resource.id == mid);
    }

    /** True when the patch tries to move a row between facilities. */
    function changesFacilityKeys(before, after) {
      let keys = ['facilityId', 'registrationFacilityId', 'careFacilityId', 'originFacilityId', 'receivingFacilityId'];
      for (let key in keys) {
        let field = keys[key];
        if (after.keys().hasAll([field]) && before.get([field]) != after.get([field])) {
          return true;
        }
      }
      return false;
    }

    /** Privileged user fields a client may never write about itself (or others). */
    function patchTouchesPrivilege(after) {
      let privileged = ['role', 'status', 'privilegeVersion', 'accountKind', 'motherId'];
      for (let key in privileged) {
        let field = privileged[key];
        if (after.keys().hasAny([field])) return true;
      }
      return false;
    }

    /** Fields a mother may never alter on her own record. */
    function patchTouchesClinicalData(after) {
      let guarded = ['riskLevel', 'currentPregnancyId', 'gestationalSnapshot', 'eddSnapshot', 'consent', 'assignedChwUserId', 'registrationFacilityId', 'status'];
      for (let key in guarded) {
        if (after.keys().hasAny([guarded[key]])) return true;
      }
      return false;
    }

    function noDelete() {
      return request.operation != 'delete';
    }

    /* ── facilities (directory: public read, admin write) ────────────── */

    match /facilities/{facilityId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    /* ── users (profiles) ───────────────────────────────────────────── */

    match /users/{userId} {
      function selfRead() {
        return signedIn() && userId == uid();
      }

      allow get: if selfRead()
        || isAdmin()
        || (isStaff() && approved() && resource.data.accountKind == 'HEALTH_WORKER');

      allow list: if isAdmin();

      // Sign-up writes exactly one document: its own uid, with a non-privileged
      // role and a status the client is allowed to declare.
      allow create: if signedIn()
        && userId == uid()
        && request.resource.data.role in ['MIDWIFE', 'NURSE', 'COMMUNITY_HEALTH_WORKER', 'FACILITY_SUPERVISOR', 'MOTHER']
        && request.resource.data.status in ['PENDING_APPROVAL', 'ACTIVE']
        && !request.resource.data.keys().hasAny(['privilegeVersion']);

      // A person may edit their own contact details — never their privileges.
      // Role, status, facility, account kind and motherId are all admin/API only.
      allow update: if isAdmin()
        || (signedIn() && userId == uid() && !patchTouchesPrivilege(request.resource.data));

      // Accounts are deactivated, never deleted, so the audit trail resolves.
      allow delete: if false;
    }

    /* ── clinical records ───────────────────────────────────────────── */

    match /mothers/{motherId} {
      allow get: if (isStaff() && approved() && sameFacility(resource.data)) || isAdmin() || ownedByMother(resource.data);
      allow list: if (isStaff() && approved()) || isAdmin();

      // Registration and community follow-up create records; mothers do not.
      allow create: if (isClinicalWriter() && request.resource.data.get(['registrationFacilityId']) == facilityId())
        || (isChw() && approved() && request.resource.data.get(['registrationFacilityId']) == facilityId())
        || isAdmin();

      allow update: if isAdmin()
        || (isClinicalWriter() && approved() && sameFacility(resource.data) && !changesFacilityKeys(resource.data, request.resource.data))
        || (isChw() && approved() && sameFacility(resource.data) && !patchTouchesClinicalData(request.resource.data) && !changesFacilityKeys(resource.data, request.resource.data))
        || (ownedByMother(resource.data) && !patchTouchesClinicalData(request.resource.data) && !changesFacilityKeys(resource.data, request.resource.data));

      allow delete: if false;
    }

    match /pregnancies/{pregnancyId} {
      allow read: if (isStaff() && approved() && sameFacility(resource.data)) || isAdmin() || ownedByMother(resource.data);
      allow create, update: if isClinicalWriter() && approved() && sameFacility(request.resource.data)
        || isAdmin();
      allow delete: if false;
    }

    match /anc_visits/{visitId} {
      allow read: if (isStaff() && approved() && sameFacility(resource.data)) || isAdmin() || ownedByMother(resource.data);
      // Visits are entered at the facility where the mother was seen.
      allow create: if (isClinicalWriter() && approved() && facilityFieldEquals(request.resource.data, 'facilityId')) || isAdmin();
      // Amendments stay inside the facility; only supervisors/admin may close one.
      allow update: if isAdmin()
        || (isClinicalWriter() && approved() && sameFacility(resource.data) && !changesFacilityKeys(resource.data, request.resource.data));
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if (isStaff() && approved() && sameFacility(resource.data)) || isAdmin() || ownedByMother(resource.data);
      allow create: if (isStaff() && approved() && facilityFieldEquals(request.resource.data, 'facilityId')) || isAdmin();
      allow update: if isAdmin()
        || (isStaff() && approved() && sameFacility(resource.data) && !changesFacilityKeys(resource.data, request.resource.data))
        || (ownedByMother(resource.data) && request.resource.data.status in ['CANCELLED', 'CONFIRMED'] && !changesFacilityKeys(resource.data, request.resource.data));
      allow delete: if false;
    }

    match /alerts/{alertId} {
      allow read: if (isStaff() && approved() && sameFacility(resource.data)) || isAdmin() || ownedByMother(resource.data);
      allow create: if isClinicalWriter() && approved() && facilityFieldEquals(request.resource.data, 'facilityId');
      // Resolving an alert requires the person to be at the alert's facility.
      allow update: if isAdmin()
        || (isStaff() && approved() && sameFacility(resource.data) && !changesFacilityKeys(resource.data, request.resource.data));
      allow delete: if false;
    }

    match /referrals/{referralId} {
      // Both ends of a handover must be able to see the referral.
      allow read: if (isStaff() && approved() && (sameFacility(resource.data) || ownedByMother(resource.data)))
        || isAdmin() || ownedByMother(resource.data);
      allow create: if (isStaff() && approved() && facilityFieldEquals(request.resource.data, 'originFacilityId')) || isAdmin();
      allow update: if isAdmin()
        || (isStaff() && approved() && sameFacility(resource.data) && !changesFacilityKeys(resource.data, request.resource.data));
      allow delete: if false;
    }

    /* ── media: documents and generated reports ─────────────────────── */

    match /documents/{documentId} {
      // `accessRoles` / `accessUserIds` decide visibility; facility rows and the
      // owning mother always qualify.
      function mayReadDoc(data) {
        let uidValue = uid();
        return data.get(['accessUserIds']) != null && data.get(['accessUserIds']).containsAny([uidValue])
          || data.get(['accessRoles']) != null && data.get(['accessRoles']).containsAny([role()]);
      }

      allow get: if isAdmin() || (approved() && (mayReadDoc(resource.data) || ownedByMother(resource.data) || sameFacility(resource.data)));
      allow list: if approved();
      // A health worker may register a document they uploaded themselves; the
      // bytes are already in media storage by the time this row is written.
      allow create: if (isStaff() && approved() && request.resource.data.uploadedBy == uid()) || isAdmin();
      allow update: if isAdmin() || (isStaff() && approved() && resource.data.uploadedBy == uid());
      // Deletion of the stored bytes happens in the API service, which verifies
      // the caller again and records the audit entry.
      allow delete: if false;
    }

    match /reports/{reportId} {
      function mayReadReport(data) {
        return data.get(['accessUserIds']) != null && data.get(['accessUserIds']).containsAny([uid()])
          || data.get(['accessRoles']) != null && data.get(['accessRoles']).containsAny([role()]);
      }

      allow get: if isAdmin() || (approved() && (mayReadReport(resource.data) || ownedByMother(resource.data) || sameFacility(resource.data)));
      allow list: if approved();
      // Reports are registered by the API service after the PDF is stored.
      allow create, update, delete: if false;
    }

    /* ── notifications and devices ──────────────────────────────────── */

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == uid();
      // The API service writes notifications; a client may only mark its own read.
      allow create: if isAdmin() || isSupervisor();
      allow update: if signedIn() && resource.data.userId == uid()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'kind', 'channels', 'title', 'body']);
      allow delete: if false;
    }

    match /devices/{deviceId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create, delete: if signedIn() && request.resource.data.userId == uid();
      allow update: if false;
    }

    /* ── education ──────────────────────────────────────────────────── */

    match /education/{resourceId} {
      allow read: if resource.data.status == 'PUBLISHED' || (isStaff() && approved());
      allow create, update, delete: if isSupervisor() && approved();
    }

    /* ── clinical rule set (read by staff, written via API/settings) ─── */

    match /alert_rules/{ruleId} {
      allow read: if isStaff() && approved();
      allow write: if false;
    }

    /* ── settings ───────────────────────────────────────────────────── */

    match /settings/{settingsId} {
      allow read: if isSupervisor() && approved();
      allow write: if isAdmin();
    }

    /* ── audit log: append-only ─────────────────────────────────────── */

    match /audit_logs/{entryId} {
      allow get: if isAdmin() || (isSupervisor() && approved() && resource.data.get(['facilityId']) == facilityId());
      allow list: if isAdmin() || isSupervisor();
      // Any approved account appends; nobody edits or removes an entry, and the
      // actor fields cannot be forged because they must match the caller's token.
      allow create: if approved()
        && request.resource.data.actorId == uid()
        && request.resource.data.actorName == claim('name')
        && request.resource.data.actorRole == role();
      allow update, delete: if false;
    }

    /* ── anything else is closed ────────────────────────────────────── */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
