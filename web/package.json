{
  "name": "mamacare-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "MAMA CARE \u2014 maternal health platform (public site + role dashboards) on Firebase + Cloudinary",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
